      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (worker) (worker_device_memory_in_use_bytes{worker=~'$worker'} / worker_device_memory_limit_bytes{worker=~'$worker'})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{worker}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Arena in use",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
