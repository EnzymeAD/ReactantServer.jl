{
 "uid": "rs-scheduling-placement",
 "title": "ReactantServer / Scheduling & Placement",
 "tags": [
  "reactantserver",
  "lpt_packing",
  "gateway"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "model",
    "label": "Model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(gateway_model_utilization, model)",
     "refId": "model"
    },
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Routing table size",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(gateway_routing_table_size)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Workers ready",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(gateway_worker_ready)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Metrics scrape OK",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(gateway_worker_metrics_up)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Max replicas (any model)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "none",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(gateway_model_replicas)"
    }
   ]
  },
  {
   "type": "bargauge",
   "title": "Models placed per worker",
   "description": "How many models lpt_packing has placed on each worker (worker labelled host:port, gateway view).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "continuous-GrYlRd"
     }
    }
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (worker) (gateway_placement_weight > 0)",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "In-flight per worker (replica outstanding)",
   "description": "In-flight ITEMS across each worker's replicas (the summed batch size of the requests in flight, not a request count), refreshed every prober tick. This is the backpressure signal; the panel below is the load the router actually compares.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 15,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (worker) (gateway_replica_outstanding)",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Gateway to worker call latency (p99)",
   "description": "Per-worker p99 of the gateway's forwarded gRPC call (route + worker round-trip), labelled by worker name (now the same worker0..N the worker_* series carry).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 6
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le, worker) (rate(gateway_worker_latency_seconds_bucket[$__rate_interval])))",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "In-flight work per worker (what the router compares)",
   "description": "The per-worker load fill_least (lpt_packing) or least_outstanding uses to choose a replica, read live at scrape time. The unit follows scheduling.work_basis, shown in the legend: GPU-seconds under compute (items x the model's measured cost per item), items under items, and a per-request cost under requests. Uneven lines mean the router is seeing an imbalance; whether it can act on it depends on where each model is placed (see the placement table).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 11
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (worker, basis) (gateway_worker_inflight_work)",
     "legendFormat": "{{worker}} ({{basis}})"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Work imbalance across workers (max - min)",
   "description": "Spread of the routing load across workers, in the same unit as the panel to the left. This is what fill_least exists to shrink: a persistently high spread means a model's replicas cannot absorb the imbalance (too few replicas, or a single-replica model pinning one GPU), not that the policy is misbehaving. Zero when every worker carries the same load, including when the fleet is idle.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 7,
    "x": 12,
    "y": 11
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 15
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(gateway_worker_inflight_work) - min(gateway_worker_inflight_work)",
     "legendFormat": "spread"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Work basis in force",
   "description": "scheduling.work_basis as the running gateway reports it, taken from the label on the load series rather than from the config file. Under lpt_packing this is runtime-mutable (gateway_ctl set-policy work_basis=...), so the config on disk is not authoritative. Empty means no work-routing scheduler is running (round_robin), or nothing has been routed yet.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 5,
    "x": 19,
    "y": 11
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "options": {
    "textMode": "name",
    "colorMode": "none",
    "graphMode": "none",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (basis) (gateway_worker_inflight_work)",
     "legendFormat": "{{basis}}"
    }
   ]
  },
  {
   "type": "table",
   "title": "Top models by utilization",
   "description": "Estimated device-seconds/second (arrival rate x measured cost). What lpt_packing is packing against.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 4,
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "model"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 340
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "device-s/s",
      "desc": true
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(25, gateway_model_utilization{model=~\"$model\"})",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "device-s/s"
      }
     }
    }
   ]
  },
  {
   "type": "table",
   "title": "Model placement (weight by worker)",
   "description": "Which worker hosts each model and its sampling weight (1.0 for a single-replica model). worker is host:port.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "model"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 300
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "model",
      "desc": false
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gateway_placement_weight{model=~\"$model\"} > 0",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      },
      "renameByName": {}
     }
    }
   ]
  },
  {
   "type": "state-timeline",
   "title": "Worker metrics scrape health",
   "description": "Whether the gateway successfully scraped each worker's metrics endpoint on the last aggregated pull.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 27
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "red"
        },
        "1": {
         "text": "ok",
         "color": "green"
        }
       }
      }
     ],
     "max": 1,
     "min": 0
    }
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "gateway_worker_metrics_up",
     "legendFormat": "{{worker}}"
    }
   ]
  }
 ]
}
