load(
    "@julia_depot//julia:image.bzl",
    "julia_compiled_layer",
    "julia_depot_layer",
    "julia_dist_layer",
    "julia_image_env",
    "julia_precompile_test",
)
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The image and its layers are public so another module (a deployment repository) can load,
# extend or push them with a bazel_dep on this one instead of rebuilding them.
package(default_visibility = ["//visibility:public"])

# The ReactantServer node image, built from the committed deploy/Manifest.toml.
#
#   bazel build //deploy:image
#   bazel test  //deploy:image_precompile_test  # the image starts without precompiling (no podman)
#   bazel run   //deploy:image_load             # loads it into podman as reactantserver:bazel
#   bazel run   //deploy:image_check            # the loaded image: caches, tini, curl, entrypoints
#   bazel run   //deploy:image_push -- --repository ghcr.io/<owner>/reactantserver   # pushes :latest
#   bazel test  //deploy:manifest_current       # the manifest still matches the workspace
#   bazel run   //deploy:relock                 # re-resolve deploy/Manifest.toml after a Project change
#   bazel run   //deploy:relock_debs            # re-resolve deploy/debs.lock.json (curl, tini)
#
# The Julia-specific layers (the distribution, the depot, the precompile caches), the image's
# environment and the precompile test come from @julia_depot//julia:image.bzl. What stays here
# is what is ours: the Ubuntu packages, the CUDA driver stub the build loads Reactant against, the
# application layer, and the image itself.
#
# WHY A SECOND MANIFEST. The workspace root's Manifest.toml is gitignored on purpose: development
# and CI resolve fresh so compat bumps are picked up. An image must not: this manifest is the
# production lock, moved deliberately with //deploy:relock and reviewed like any other change.
# It is a manifest for the ROOT Project.toml, and it lives here only so the gitignore can stay as
# it is. The depot layer stages it beside the root project and the member Project.tomls, because
# Pkg resolves a manifest next to its (real, symlink-resolved) project.

# CUDA userspace the Reactant_jll artifact is selected for. Must agree with the base image
# (@reactantserver_cuda_base, MODULE.bazel): Reactant_jll's platform augmentation reads these at
# instantiate time to pick the artifact and at run time to load it, and a mismatch loads the wrong
# library.
_REACTANT_GPU_ENV = {
    "REACTANT_GPU": "cuda",
    "REACTANT_GPU_VERSION": "13.1",
}

# Where the image keeps the application. Julia and the depot take image.bzl's defaults,
# /opt/julia and /opt/julia-depot.
_APP = "/opt/reactantserver"

# The projects the image starts Julia in, relative to _APP, each precompiled by
# //deploy:compiled_layer and checked by //deploy:image_precompile_test. A package's cache depends
# on the active project's preferences (the worker's LocalPreferences.toml configures Reactant), so
# each entry point needs its own.
#   packages/ReactantServerNode     the supervisor (runtime/entrypoint.node.sh)
#   packages/ReactantServer         a worker (spawned by the supervisor, or entrypoint.worker.sh)
#   packages/ReactantServerGateway  the embedded gateway (spawned by the supervisor)
#   .                               the worker-role healthcheck (runtime/healthcheck.worker.jl)
_ENTRY_PROJECTS = [
    "packages/ReactantServerNode",
    "packages/ReactantServer",
    "packages/ReactantServerGateway",
    ".",
]

_ENTRY_PROJECT_PATHS = [_APP if p == "." else _APP + "/" + p for p in _ENTRY_PROJECTS]

# Where the CUDA driver stub sits in the build-time tree. Never in the image; see :cuda_stub_layer.
_CUDA_STUB_DIR = "/build/cuda-stub"

# What Julia needs to load the stack on a build host: the driver stub in place of libcuda.so.1, the
# host's GPUs hidden so a build never touches them, and the artifact selection. `{root}` is the
# tree the layers are unpacked into (see image.bzl).
_BUILD_LOAD_ENV = _REACTANT_GPU_ENV | {
    "CUDA_VISIBLE_DEVICES": "",
    "LD_LIBRARY_PATH": "{root}" + _CUDA_STUB_DIR,
}

_STAGE = """
workspace_path() {
    # workspace_path <execroot path>: the file's path inside this repository. When another module
    # builds the image through a bazel_dep, this repository's files arrive as
    # external/<repo>/<path> (or ../<repo>/<path> with the sibling layout), and that prefix must
    # not reach the image or Pkg: the workspace would land one level too deep.
    case "$$1" in
        external/*) p="$${1#external/}"; echo "$${p#*/}" ;;
        ../*) p="$${1#../}"; echo "$${p#*/}" ;;
        *) echo "$$1" ;;
    esac
}
stage_workspace() {
    # stage_workspace <dir>: the root Project.toml and the member Project.tomls at their workspace
    # paths, plus the committed manifest beside the root. -L because Bazel stages srcs as symlinks.
    for f in $(locations //:workspace_projects); do
        rel="$$(workspace_path "$$f")"
        mkdir -p "$$1/$$(dirname "$$rel")"
        cp -L "$$f" "$$1/$$rel"
    done
    cp -L $(location Manifest.toml) "$$1/Manifest.toml"
}
"""

# The layers written here are deterministic tars in the same form as image.bzl's: sorted, epoch
# mtimes, root-owned by number, permissions normalised. Without these a layer's digest changes on
# every build and nothing downstream can be cached or compared.
_TAR = "LC_ALL=C tar --create --file \"$@\" --format=gnu --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --mode='u=rwX,go=rX'"

# The Ubuntu packages the image adds to the base (curl, tini and the libraries curl needs), from
# the pinned downloads in deploy/debs.lock.json, unpacked the way dpkg would lay them out.
#
# The control stanza of each package lands in /var/lib/dpkg/status.d/<name>, where image scanners
# (Trivy, Grype, Syft) inventory packages installed without dpkg, so the added packages stay
# visible to vulnerability scans.
#
# /bin, /lib and friends are symlinks into /usr in the base (Ubuntu's merged /usr). A package that
# still ships files under /lib would otherwise put a real lib/ directory in this layer, which
# replaces the base's symlink and hides every library under it, so those files are moved to their
# /usr home first, as dpkg does on a merged-/usr system.
genrule(
    name = "debs_layer",
    srcs = ["@reactantserver_debs//:debs"],
    outs = ["reactantserver-debs.tar"],
    cmd = """
set -euo pipefail
stage="$$(mktemp -d)"
trap 'rm -rf "$$stage"' EXIT
status="$$stage/var/lib/dpkg/status.d"
mkdir -p "$$status"
for deb in $(locations @reactantserver_debs//:debs); do
    $(BSDTAR_BIN) -xOf "$$deb" 'data.tar.*' | $(BSDTAR_BIN) -xf - -C "$$stage"
    control="$$($(BSDTAR_BIN) -xOf "$$deb" 'control.tar.*' | $(BSDTAR_BIN) -xOf - ./control)"
    name="$$(printf '%s\\n' "$$control" | sed -n 's/^Package: //p')"
    printf '%s\\n' "$$control" > "$$status/$$name"
done
for d in bin sbin lib lib32 lib64 libx32; do
    if [ -d "$$stage/$$d" ] && [ ! -L "$$stage/$$d" ]; then
        mkdir -p "$$stage/usr/$$d"
        cp -a "$$stage/$$d/." "$$stage/usr/$$d/"
        rm -rf "$$stage/$$d"
    fi
done
[ -x "$$stage/usr/bin/curl" ] && [ -x "$$stage/usr/bin/tini" ] || { echo "FAILED: curl or tini missing from the layer" >&2; exit 1; }
# The children of the stage, never the stage itself: a "./" entry would carry mktemp's 0700 onto /.
""" + _TAR + """ --directory "$$stage" $$(ls -A "$$stage")
""",
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
)

# The CUDA driver stub, libcuda.so, taken from the pinned CUDA base itself so it always matches the
# base's CUDA release, as a layer at _CUDA_STUB_DIR. BUILD TIME ONLY: it is among the layers of
# :compiled_layer and :image_precompile_test and never among the image's. The CUDA build of
# libReactantExtra.so lists libcuda.so.1 as NEEDED, so loading Reactant (which precompiling does)
# fails on a host without an NVIDIA driver, and would load the host's real driver on one that has
# it. The stub answers every call with "no device"; a container gets the real driver from its host.
#
# The base's layers are searched in manifest order and the last copy wins, as an overlay would
# resolve it.
genrule(
    name = "cuda_stub_layer",
    srcs = ["@reactantserver_cuda_base_linux_amd64"],
    outs = ["reactantserver-cuda-stub.tar"],
    cmd = """
set -euo pipefail
layout=$(location @reactantserver_cuda_base_linux_amd64)
blobs="$$layout/blobs/sha256"
member=usr/local/cuda-{gpu_version}/targets/x86_64-linux/lib/stubs/libcuda.so
manifest="$$(grep -o 'sha256:[0-9a-f]*' "$$layout/index.json" | head -1 | cut -d: -f2)"
found="$$(mktemp -d)"
stage="$$(mktemp -d)"
trap 'rm -rf "$$found" "$$stage"' EXIT
for layer in $$(tr ',' '\\n' < "$$blobs/$$manifest" | sed -n '/"layers"/,$$p' | grep -o 'sha256:[0-9a-f]*' | cut -d: -f2); do
    $(BSDTAR_BIN) -xf "$$blobs/$$layer" -C "$$found" "$$member" 2>/dev/null || true
done
[ -f "$$found/$$member" ] || {{ echo "FAILED: $$member is not in the base image" >&2; exit 1; }}
mkdir -p "$$stage{stub_dir}"
cp "$$found/$$member" "$$stage{stub_dir}/libcuda.so.1"
""".format(
        gpu_version = _REACTANT_GPU_ENV["REACTANT_GPU_VERSION"],
        stub_dir = _CUDA_STUB_DIR,
    ) + _TAR + """ --directory "$$stage" {top}
""".format(top = _CUDA_STUB_DIR.split("/")[1]),
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
)

# The image's Julia layout and environment, declared once: the oci_image takes the file this
# writes, and the compiled layer and the precompile test take the same facts, so the caches are
# built for, and checked against, exactly the environment the image runs with.
#
# The workspace root is a depot too (extra_depots), and not by accident: Julia records a
# precompiled package's source files relative to the depot that holds them ("@depot/..."), which is
# what lets a cache built in a temporary tree load from /opt. Packages outside every depot are
# recorded by absolute path and would be stale in the image, so the workspace root is listed to make
# the workspace's own packages relocatable like the registry ones. The search order comes out as
#
#   /opt/julia-depot:/opt/reactantserver:/opt/julia/local/share/julia:/opt/julia/share/julia
#
# The caches are compiled for the official Julia build's x86_64 CPU targets (image.bzl's default),
# so they load on any x86_64 host rather than only on CPUs like the build machine's.
#
# PATH becomes /opt/julia/bin:$PATH, which rules_oci expands against the CUDA base's own PATH.
# JULIA_PKG_OFFLINE is set too: nothing in the image resolves or installs, and a stale cache (a
# mounted, edited package) still precompiles into the depot offline.
julia_image_env(
    name = "image_env",
    env = _REACTANT_GPU_ENV | {
        "REACTANT_WORKSPACE_ROOT": _APP,
        "JULIA_SSL_CA_ROOTS_PATH": "/etc/ssl/certs/ca-certificates.crt",
        # utility as well as compute: the entrypoint's GPU-reclaim gate runs nvidia-smi.
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
        "NVIDIA_VISIBLE_DEVICES": "all",
    },
    extra_depots = [_APP],
    project = _APP,
)

# Julia at /opt/julia rather than as the base, because the base has to be CUDA's. The
# distribution's own relative symlinks are kept, so its libraries are not shipped twice.
julia_dist_layer(
    name = "julia_layer",
    julia = "@reactantserver_julia",
)

# The depot, instantiated from the manifest into an empty tree at /opt/julia-depot.
#
# FULL, not artifacts-only: the image loads its packages from source (with the caches of
# //deploy:compiled_layer), not from a sysimage, so the packages themselves are the code.
#
# No `depot`, so the General registry is fetched into the clean depot rather than copied from
# whatever this host has; the manifest pins every package by tree hash, so the registry's state
# cannot change what is installed. Set JULIA_PKG_SERVER in user.bazelrc (--action_env) to go
# through a mirror.
julia_depot_layer(
    name = "depot_layer",
    contents = "full",
    env = _REACTANT_GPU_ENV,
    julia = "@reactantserver_julia",
    manifest = "Manifest.toml",
    project = "//:Project.toml",
    # The member Project.tomls, which the workspace's [workspace] table needs to instantiate.
    srcs = ["//:workspace_projects"],
)

# The container's entrypoints and healthchecks (see runtime/README.md).
filegroup(
    name = "runtime_scripts",
    srcs = glob(["runtime/*.sh", "runtime/*.jl"]),
)

# The application at /opt/reactantserver, in the workspace layout the entrypoints expect: the root
# Project.toml with THIS manifest beside it, the member packages and config/. The entrypoints and
# healthchecks are installed in /usr/local/bin and the default node file copied to
# /etc/reactantserver/node.yaml, the paths docker-compose.yml, its healthcheck command and a
# mounted node file expect.
genrule(
    name = "app_layer",
    srcs = [
        "Manifest.toml",
        ":runtime_scripts",
        "//:node_config",
        "//:workspace_projects",
        "//:workspace_sources",
    ],
    outs = ["reactantserver-app.tar"],
    cmd = _STAGE + """
set -euo pipefail
stage="$$(mktemp -d)"
trap 'rm -rf "$$stage"' EXIT
app="$$stage{app}"
mkdir -p "$$app"
for f in $(locations //:workspace_sources) $(locations //:node_config); do
    rel="$$(workspace_path "$$f")"
    mkdir -p "$$app/$$(dirname "$$rel")"
    cp -L "$$f" "$$app/$$rel"
done
stage_workspace "$$app"
mkdir -p "$$stage/usr/local/bin" "$$stage/etc/reactantserver"
for f in $(locations :runtime_scripts); do
    cp -L "$$f" "$$stage/usr/local/bin/"
done
chmod a+x "$$stage/usr/local/bin/"*.sh
cp "$$app/config/node.default.yaml" "$$stage/etc/reactantserver/node.yaml"
""".format(app = _APP) + _TAR + """ --directory "$$stage" etc opt usr
""",
)

# The precompile caches, so a container starts serving without first compiling ~150 packages.
#
# Built from the image's own Julia, depot and application layers, unpacked into one tree with the
# image's layout, so the caches are for exactly the files the image ships, and compiled for the
# depot path and CPU targets of :image_env, so they load unchanged from /opt. The driver stub layer
# rides along for the build only.
#
# Precompiling is also the first time the whole stack is loaded, so a package that fails to load
# fails the build here rather than a container at start.
julia_compiled_layer(
    name = "compiled_layer",
    env = _BUILD_LOAD_ENV,
    image_env = ":image_env",
    julia = "@reactantserver_julia",
    layers = [
        ":julia_layer",
        ":depot_layer",
        ":app_layer",
        ":cuda_stub_layer",
    ],
    projects = _ENTRY_PROJECT_PATHS,
)

# The layers in the order they change, least often first, so a push or a pull after a code change
# moves only the application layer (and the caches, when a package's sources change).
_IMAGE_LAYERS = [
    ":debs_layer",
    ":julia_layer",
    ":depot_layer",
    ":compiled_layer",
    ":app_layer",
]

# Root, and not by oversight: the entrypoint's GPU-reclaim gate and the supervisor expect it, and a
# stale cache (a mounted, edited package) must still be able to precompile into the depot.
oci_image(
    name = "image",
    base = "@reactantserver_cuda_base",
    # tini as PID 1: it reaps the zombies a supervisor of subprocesses leaves behind and forwards
    # signals, so `podman stop` reaches the supervisor's own SIGTERM handler, which shuts the
    # workers down gracefully.
    entrypoint = [
        "/usr/bin/tini",
        "--",
        "/usr/local/bin/entrypoint.node.sh",
    ],
    env = ":image_env",
    # The embedded gateway's gRPC and metrics/health ports. The workers role binds per-worker ports
    # (base_port+i, metrics_base_port+i) instead; publish the range you configured.
    exposed_ports = [
        "8001/tcp",
        "8002/tcp",
    ],
    tars = _IMAGE_LAYERS,
    workdir = _APP,
)

# Every entry project loads from the baked caches with nothing precompiled and no cache rejected,
# checked on the image's layers without a container, so it needs no podman. Manual because it
# builds the whole image; //deploy:image_check covers what only a container shows.
julia_precompile_test(
    name = "image_precompile_test",
    size = "large",
    env = _BUILD_LOAD_ENV,
    image_env = ":image_env",
    julia = "@reactantserver_julia",
    layers = [l for l in _IMAGE_LAYERS if l != ":debs_layer"] + [":cuda_stub_layer"],
    projects = _ENTRY_PROJECT_PATHS,
    tags = ["manual"],
)

oci_load(
    name = "image_load",
    image = ":image",
    # Explicit, because rules_oci probes for docker first, and on hosts where a docker CLI is
    # installed but its socket is unreachable that probe wins and fails.
    loader = "podman.sh",
    repo_tags = ["reactantserver:bazel"],
)

# Push the image as :latest. The repository is given at run time, so this file names no registry
# account; credentials come from the docker config (`docker login`, `podman login --authfile
# ~/.docker/config.json`, or docker/login-action in CI):
#
#   bazel run //deploy:image_push -- --repository ghcr.io/<owner>/reactantserver
#
# .github/workflows/image.yml runs exactly this.
oci_push(
    name = "image_push",
    image = ":image",
    remote_tags = ["latest"],
)

# Check a loaded image: every entry project loads from the baked caches without precompiling, and
# the tools the entrypoint and healthcheck call are present. Needs podman, and the image loaded
# first (bazel run //deploy:image_load); runs on a host with or without a GPU.
sh_binary(
    name = "image_check",
    srcs = ["image_check.sh"],
    env = {
        "RS_IMAGE": "localhost/reactantserver:bazel",
        "RS_PROJECTS": " ".join(_ENTRY_PROJECTS),
        "RS_APP": _APP,
        "RS_STUB": "/usr/local/cuda-{}/targets/x86_64-linux/lib/stubs/libcuda.so".format(
            _REACTANT_GPU_ENV["REACTANT_GPU_VERSION"],
        ),
    },
    tags = ["manual"],  # podman, and a loaded image
)

# The committed manifest must be current for the root project and its members. Without this, a
# [deps] or [compat] change merges, the image instantiates a manifest for a project that no longer
# exists in that form, and Pkg either re-resolves at container start or refuses.
sh_test(
    name = "manifest_current",
    size = "small",
    srcs = ["manifest_current.sh"],
    data = [
        "Manifest.toml",
        "//:workspace_projects",
        "@reactantserver_julia//:dist",
        "@reactantserver_julia//:bin/julia",
    ],
    env = {
        "RS_JULIA": "$(rootpath @reactantserver_julia//:bin/julia)",
        "RS_MANIFEST": "$(rootpath Manifest.toml)",
        "RS_PROJECTS": "$(rootpaths //:workspace_projects)",
    },
)

# Re-resolve deploy/Manifest.toml against the current workspace and write it back into the source
# tree. Keeps every version it can (Pkg.resolve, not Pkg.update); pass package names to move those:
#
#   bazel run //deploy:relock                         # after a [deps]/[compat] change
#   bazel run //deploy:relock -- Reactant Reactant_jll # deliberately take newer versions
sh_binary(
    name = "relock",
    srcs = ["relock.sh"],
    data = [
        "@reactantserver_julia//:dist",
        "@reactantserver_julia//:bin/julia",
    ],
    env = _REACTANT_GPU_ENV | {
        "RS_JULIA": "$(rootpath @reactantserver_julia//:bin/julia)",
    },
    tags = ["manual"],  # network, and rewrites the source tree
)

# Re-resolve deploy/debs.lock.json: the packages the base lacks for curl and tini, resolved by apt
# inside the pinned base and pinned to an Ubuntu snapshot. Needs podman.
#
#   bazel run //deploy:relock_debs                      # today's snapshot
#   bazel run //deploy:relock_debs -- 20260928T000000Z  # a given snapshot
sh_binary(
    name = "relock_debs",
    srcs = ["relock_debs.sh"],
    tags = ["manual"],  # podman, network, and rewrites the source tree
)
