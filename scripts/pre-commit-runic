#!/usr/bin/env bash
# Runic pre-commit hook: format the source tree with Runic and re-stage the result.
#
# Runs `runic --inplace packages docs examples tools docker` — everything tracked except
# `lib/`, which holds only the gRPCServer.jl submodule (formatted in its own repo).
#
# Requires the `runic` CLI (Julia >= 1.12 Pkg app):
#     julia -e 'using Pkg; Pkg.Apps.add("Runic")'
#
# .git/hooks/ is machine-local and not versioned, so install this script as
# your pre-commit hook in a fresh clone with:
#     cp scripts/pre-commit-runic .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -u

if ! command -v runic >/dev/null 2>&1; then
    echo "pre-commit: runic CLI not found; skipping formatting." >&2
    echo "  Install it once with:  julia -e 'using Pkg; Pkg.Apps.add(\"Runic\")'" >&2
    exit 0
fi

echo "pre-commit: formatting packages/docs/examples/tools/docker with Runic..." >&2
runic --inplace --diff packages docs examples tools docker
status=$?

# Re-stage the .jl files the formatter touched so the commit includes the formatted code.
# (git ls-files never errors on empty matches, unlike `git add -u` with an unmatched
# pathspec, so a dir with no .jl files can't silently skip the re-stage.)
git ls-files -m -z -- packages docs examples tools docker | grep -z '\.jl$' | xargs -0 -r git add --

exit $status
