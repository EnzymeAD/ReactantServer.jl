module(
    name = "reactant_server",
    version = "0.0.0",
)

# Bazel builds the reproducible node image (//deploy:image), which is the supported deployment;
# nothing else in this repository depends on it. Tests, docs and running from a source checkout
# stay plain Julia (see CONTRIBUTING.md). What Bazel adds is an image assembled from a COMMITTED
# manifest (deploy/Manifest.toml) with no Pkg resolve anywhere in the build, so the same commit
# always yields the same package and artifact set.

# Bazel 9 moved sh_binary/sh_test out of the core into rules_shell.
bazel_dep(name = "rules_shell", version = "0.8.0")

# rules_oci assembles OCI images with no daemon; podman is needed only to load and run the result.
#
# 2.3.3, the latest release, which has not reached the Bazel Central Registry (2.3.0 is the newest
# there), so it is fetched from the release archive. The fix that matters here is oci_load's: before
# 2.3.1 (#881) it reported success when the tar it streams into the loader failed, so a broken
# load of this multi-gigabyte image looked like a good one. 2.3.1 also makes oci_pull repositories
# resolve their own dependencies under bzlmod (#891). Since 2.3.0 it also depends on a
# current aspect_bazel_lib, so the Bazel 9 workaround of naming aspect_bazel_lib here is gone.
# Drop the override once the registry has 2.3.3 or later.
bazel_dep(name = "rules_oci", version = "2.3.3")
archive_override(
    module_name = "rules_oci",
    integrity = "sha256-JD6sh+xB1o0dnm0hiEpQ7CjgMfcCsLn83H+Xw/PVOJo=",
    strip_prefix = "rules_oci-2.3.3",
    urls = ["https://github.com/bazel-contrib/rules_oci/releases/download/v2.3.3/rules_oci-v2.3.3.tar.gz"],
)

# bsdtar, from the toolchain rules_oci uses (tar.bzl since rules_oci 2.3), reads .deb files (ar
# archives holding zstd or xz tarballs) and the pulled base image's layers, so //deploy needs
# neither dpkg nor ar on the host.
bazel_dep(name = "tar.bzl", version = "0.10.9")

tar = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(tar, "bsd_tar_toolchains")

# The Ubuntu packages the image adds to the CUDA base (curl, tini and their dependencies), each
# pinned by snapshot URL and sha256 in deploy/debs.lock.json. Re-resolve with
# `bazel run //deploy:relock_debs`.
debs = use_extension("//deploy:debs.bzl", "debs")
debs.lock(
    name = "reactantserver_debs",
    lock = "//deploy:debs.lock.json",
)
use_repo(debs, "reactantserver_debs")

# Julia itself, and the image rules (julia/image.bzl): the distribution, depot and
# precompile-cache layers, the image environment, and the precompile test.
#
# 0.2.0 has not reached the Bazel Central Registry, so it is pinned to the commit that adds
# julia.depot's `project`, which the image's lock needs (see reactantserver_depot below). Drop the
# override once the registry has 0.2.0.
bazel_dep(name = "julia_depot", version = "0.2.0")
git_override(
    module_name = "julia_depot",
    commit = "3f92730fb582833869bfb5168cd9a6e5b3924a4a",
    remote = "https://github.com/csvance/julia_depot.git",
)

# Julia, fetched and pinned by sha256, so no build host needs it installed. It must match
# deploy/Manifest.toml's julia_version; //deploy:manifest_current fails when they disagree. The
# repository name is prefixed because distribution names share one namespace across every module
# that uses the extension: a consumer that declares its own `julia_dist` must not collide.
julia = use_extension("@julia_depot//julia:extensions.bzl", "julia")
julia.dist(
    name = "reactantserver_julia",
    version = "1.12.7",
)

# The image's environment: the root workspace pinned by the committed production lock,
# deploy/Manifest.toml (see deploy/BUILD.bazel for why the lock lives there). The lock is not
# beside the Project.toml it locks, so `project` names it, and the depot is instantiated from a
# copy of the project staged inside the repository. That copy holds only Project.tomls, never
# sources, so nothing is precompiled at fetch: the image's caches come from //deploy:compiled_layer.
# `project_srcs` must list every workspace member (the root Project.toml's [workspace] projects);
# the fetch fails, naming it, when one is missing. `env` selects the same Reactant artifact the
# image ships (see _REACTANT_GPU_ENV in deploy/BUILD.bazel), so the fetch downloads no other.
julia.depot(
    name = "reactantserver_depot",
    env = {
        "REACTANT_GPU": "cuda",
        "REACTANT_GPU_VERSION": "13.1",
    },
    julia = "@reactantserver_julia",
    manifest = "//deploy:Manifest.toml",
    precompile = False,
    project = "//:Project.toml",
    project_srcs = [
        "//:packages/ReactantServerCore/Project.toml",
        "//:packages/ReactantServer/Project.toml",
        "//:packages/ReactantServerGateway/Project.toml",
        "//:packages/ReactantServerClient/Project.toml",
        "//:packages/ReactantServerNode/Project.toml",
    ],
)
use_repo(julia, "reactantserver_depot", "reactantserver_julia")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "reactantserver_cuda_base",
    # nvidia/cuda:13.1.2-cudnn-devel-ubuntu24.04, pinned by digest.
    #
    # Deliberately fat. Reactant_jll's CUDA 13.1 artifact statically links cuDNN and cuBLASLt but
    # dlopens libnvJitLink.so.13, libnvrtc.so.13 and libcupti.so by soname, and none of the three
    # is injected by the NVIDIA container runtime (only libcuda.so.1 is). A -devel base carries
    # them all; this is the configuration that was proven on an A6000 with the executable cache.
    # Trim to a smaller base only after a GPU run shows which libraries are touched. The CUDA
    # version must match REACTANT_GPU_VERSION in //deploy:image.
    digest = "sha256:08d6facb6a72f918beb3ffe5b57cff72402a203f44428831262e95c7466d4188",
    image = "index.docker.io/nvidia/cuda",
    platforms = ["linux/amd64"],
)
use_repo(oci, "reactantserver_cuda_base", "reactantserver_cuda_base_linux_amd64")
